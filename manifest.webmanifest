{
  "name": "司序 Marshal · 知所先后",
  "short_name": "司序",
  "description": "把群通知排成做得到的一周。",
  "lang": "zh-CN",
  "start_url": "./#/calendar",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f8fc",
  "theme_color": "#2563b8",
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "images", "accept": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp"] }] }
  }
}
